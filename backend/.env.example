
PORT=8080

# Supabase PostgreSQL
DB_URL=jdbc:postgresql://YOUR_DB_HOST:5432/postgres?sslmode=require
DB_USERNAME=YOUR_DB_USERNAME
DB_PASSWORD=YOUR_DB_PASSWORD

# Optional separate migration role (DDL permissions); runtime role should only have DML.
# FLYWAY_DB_URL=jdbc:postgresql://YOUR_DB_HOST:5432/postgres?sslmode=require
# FLYWAY_DB_USERNAME=YOUR_MIGRATION_USERNAME
# FLYWAY_DB_PASSWORD=YOUR_MIGRATION_PASSWORD

# React frontend
FRONTEND_URL=http://localhost:5173

# JWT authentication
# Base64 of at least 32 cryptographically random bytes; never reuse test keys.
JWT_SECRET=REPLACE_WITH_BASE64_ENCODED_RANDOM_SECRET
# Milliseconds: 15 minutes (allowed range: 1 minute to 1 hour).
JWT_EXPIRATION=900000
